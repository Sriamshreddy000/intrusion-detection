# Dataset archives — never commit, wherever they land (extraction leftovers
# included) — this is a safety net on top of data/ being ignored below.
*.tar.bz2
*.tar.gz
*.zip

# Data — never commit, including samples
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.csv
*.tsv
*.parquet
*.pkl
*.pickle
*.h5
*.db
*.sqlite

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.Python

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Model artifacts
*.model
*.joblib
models/*.bin

# Reports/figures generated by runs (regenerate, don't track output noise)
reports/figures/*
!reports/figures/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Env/secrets
.env
.env.*

# local tooling
CLAUDE.md
.claude/

# figures are deliverables, not data
!reports/figures/*.png
